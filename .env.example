# Cloud MySQL (Aiven) only: path to the CA cert -> turns on verified SSL. Leave commented for local MySQL.
# MYSQL_SSL_CA=certs/aiven-ca.pem

# Aiven for MySQL (free plan). mysql-csun-demo (SSL mode REQUIRED)
MYSQL_HOST=mysql-csun-demo-my-b005.i.aivencloud.com
MYSQL_PORT=10463
# Aiven requires SSL. Download ca.pem from the service Overview page and save it here.
MYSQL_SSL_CA=mysql/ca.pem
# App login created by mysql/04_app_user.sql (run it on Aiven as avnadmin first).
MYSQL_USER=ticket_app
MYSQL_PASSWORD=MySQL-N@7kGHTgAy-n
MYSQL_DATABASE=event_ticketing_db
# Aiven free plan allows 76 connections total - keep the pool small.
MYSQL_POOL_SIZE=5


MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DATABASE=event_ticketing_db
MONGODB_COLLECTION=event_content
